# GroupTrack Configuration
# Backend Server Base URL
BACKEND_BASE_URL=http://10.0.2.2:3000
# Google Maps API Key for Android Map SDK
# Replace with your key restricted to package com.aistudio.grouptrack.nxjqv
MAPS_API_KEY=YOUR_GOOGLE_MAPS_API_KEY

# Backend Secrets (Docker / NestJS)
POSTGRES_USER=grouptrack_user
POSTGRES_PASSWORD=grouptrack_secure_pass
POSTGRES_DB=grouptrack_db
JWT_SECRET=grouptrack_jwt_super_secret_production_key_2026
LOCATION_RETENTION_DAYS=30

